    "Generate a text with AI, or add an article, a PDF or a scanned page you want to read faster.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε ένα κείμενο με AI ή πρόσθεσε ένα άρθρο, ένα PDF ή μια σαρωμένη σελίδα που θέλεις να διαβάσεις πιο γρήγορα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un texto con IA o añade un artículo, un PDF o una página escaneada que quieras leer más rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un testo con l'IA oppure aggiungi un articolo, un PDF o una pagina scansionata che vuoi leggere più velocemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте текст с ИИ или добавьте статью, PDF или отсканированную страницу, которую хотите прочитать быстрее."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijo një tekst me AI, ose shto një artikull, një PDF ose një faqe të skanuar që do ta lexosh më shpejt."
          }
        }
      }
    },
