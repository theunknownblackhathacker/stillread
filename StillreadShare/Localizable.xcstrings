{
  "sourceLanguage": "en",
  "strings": {
    "Copied. Open Stillread, tap + and then Paste.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφηκε. Άνοιξε το Stillread, πάτησε + και μετά Επικόλληση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Abre Stillread, toca + y luego Pegar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiato. Apri Stillread, tocca + e poi Incolla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано. Откройте Stillread, нажмите + и затем «Вставить»."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U kopjua. Hap Stillread, prek + dhe pastaj Ngjit."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέλος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U krye"
          }
        }
      }
    },
    "Sending to Stillread…": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποστολή στο Stillread…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando a Stillread…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio a Stillread…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка в Stillread…"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dërgohet te Stillread…"
          }
        }
      }
    },
    "There's nothing here Stillread can read.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κάτι εδώ που μπορεί να διαβάσει το Stillread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada que Stillread pueda leer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è niente che Stillread possa leggere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нет ничего, что Stillread может прочитать."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këtu nuk ka asgjë që Stillread mund të lexojë."
          }
        }
      }
    }
  },
  "version": "1.0"
}
